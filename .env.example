# Copie para .env.local e preencha. Nunca versione .env.local.

# --- Supabase (Project Settings → API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). É pública por natureza.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta (sb_secret_... ou service_role). SOMENTE no servidor.
SUPABASE_SECRET_KEY=

# URL pública do site (links de e-mail, callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inteligência artificial (opcional) ------------------------------
# anthropic | openai_compatible | nenhum
IA_PROVEDOR=nenhum
IA_API_KEY=
# Modelo do provedor. Ex.: claude-sonnet-5-5 (Anthropic) ou o nome do modelo no provedor compatível.
IA_MODELO=
# Somente para openai_compatible (OpenAI, Gemini, Groq, OpenRouter, Ollama etc.)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (modelo ex.: gemini-3.5-flash)
IA_BASE_URL=
# Modelo usado se o principal estiver sobrecarregado (opcional)
# Modelos reserva, em ordem, separados por vírgula (usados quando o principal esgota a cota ou está sobrecarregado).
IA_MODELO_RESERVA=
# Preço em US$ por milhão de tokens, usado para estimar custos.
IA_PRECO_ENTRADA_POR_MTOK=0
IA_PRECO_SAIDA_POR_MTOK=0
# Teto mensal da plataforma (US$). 0 bloqueia chamadas pagas.
IA_ORCAMENTO_MENSAL_USD=0

# --- Monitoramento e tarefas agendadas -------------------------------
# Segredo compartilhado com o GitHub Actions (gere com: openssl rand -hex 32)
CRON_SECRET=
